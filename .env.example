# ════════════════════════════════════════════════════════════
#  Kamu TIDAK perlu mengisi semua. Cukup isi yang kamu punya.
#  Aplikasi pakai "Auto (Model Gratis)" sebagai default.
# ════════════════════════════════════════════════════════════

# OpenRouter — untuk model GRATIS (default aplikasi)
# Daftar gratis di https://openrouter.ai → Settings → Keys
# Model "openrouter/free" otomatis pilih model gratis terbaik
OPENROUTER_API_KEY=sk-or-xxxxx

# Google Gemini — kamu punya Gemini 2.5 Flash-Lite
# Daftar gratis di https://aistudio.google.com/apikey
GOOGLE_API_KEY=xxxxx

# Anthropic (opsional) — untuk Claude Opus/Sonnet
# ANTHROPIC_API_KEY=sk-ant-xxxxx

# OpenAI (opsional) — untuk GPT-4o
# OPENAI_API_KEY=sk-xxxxx

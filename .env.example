# ============================================================
# SEOTulis Environment Variables
# Copy file ini ke .env.local dan isi nilai yang diperlukan.
# JANGAN pernah commit .env.local ke git.
# ============================================================

# ── AI Providers ─────────────────────────────────────────────

# JoinBareng — PROVIDER UTAMA (OpenAI-compatible proxy, 1 key untuk semua model gpt-5.x)
# Ambil dari dashboard JoinBareng: https://joinbareng.com/dashboard
JOINBARENG_API_KEY=sk-jb-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JOINBARENG_BASE_URL=https://joinbareng.com/api/ai-proxy-v2/v1

# CUSTOM — slot provider bebas (OpenAI-compatible). Pilih model "Custom (env)" di UI.
# Isi 3 baris di bawah dgn provider apa pun, lalu redeploy. Contoh pakai SumoPod:
#   CUSTOM_AI_BASE_URL=https://ai.sumopod.com/v1
#   CUSTOM_AI_MODEL=gpt-5-mini      (cek id model di tab Models SumoPod)
#   CUSTOM_AI_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Contoh lain (OpenRouter): BASE_URL=https://openrouter.ai/api/v1, MODEL=deepseek/deepseek-chat
CUSTOM_AI_BASE_URL=
CUSTOM_AI_MODEL=
CUSTOM_AI_KEY=

# Google Gemini (opsional — hanya untuk generate gambar AI / Imagen)
# Daftar gratis di https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIzaSy-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenRouter (opsional — fallback model lain)
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI (opsional — untuk model GPT resmi)
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Supabase ─────────────────────────────────────────────────

# Project URL (dari Settings > API di Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Anon/public key (aman untuk expose di client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — RAHASIA, hanya untuk server-side!
# Memberikan akses penuh ke database (bypass RLS)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Mayar Payment ────────────────────────────────────────────

# API key Mayar (headless). Ambil di dashboard Mayar → Pengaturan → API/Webhook.
MAYAR_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Token webhook Mayar (opsional tapi disarankan — verifikasi defense-in-depth).
# Set URL webhook di Mayar ke: https://<domain>/api/payment/webhook
MAYAR_WEBHOOK_TOKEN=

# true = produksi (api.mayar.id), false = sandbox (api.mayar.club)
MAYAR_IS_PRODUCTION=false

# ── App ──────────────────────────────────────────────────────

# URL produksi aplikasi (dipakai untuk redirect pembayaran Mayar)
SITE_URL=https://yourdomain.com

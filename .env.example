# ============================================================
# SEOTulis Environment Variables
# Copy file ini ke .env.local dan isi nilai yang diperlukan.
# JANGAN pernah commit .env.local ke git.
# ============================================================

# ── AI Providers ─────────────────────────────────────────────

# OpenRouter (untuk model Mistral, Llama, Gemma, dll)
# Daftar gratis di https://openrouter.ai → Settings → Keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini + Imagen (untuk model Gemini dan generate gambar)
# Daftar gratis di https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIzaSy-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI (opsional — untuk model GPT-4o, dll)
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Supabase ─────────────────────────────────────────────────

# Project URL (dari Settings > API di Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Anon/public key (aman untuk expose di client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — RAHASIA, hanya untuk server-side!
# Memberikan akses penuh ke database (bypass RLS)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Midtrans Payment ─────────────────────────────────────────

# Server key — RAHASIA, hanya server-side
MIDTRANS_SERVER_KEY=Mid-server-xxxxxxxxxxxxxxxxxxxxxx

# Client key (bisa expose ke client)
MIDTRANS_CLIENT_KEY=Mid-client-xxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=Mid-client-xxxxxxxxxxxxxxxxxxxxxx

# Merchant ID
MIDTRANS_MERCHANT_ID=Gxxxxxxxxxx

# true = production, false = sandbox
MIDTRANS_IS_PRODUCTION=false

# ── Sanity CMS (Blog) ────────────────────────────────────────

NEXT_PUBLIC_SANITY_PROJECT_ID=xxxxxxxx
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=skxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── App ──────────────────────────────────────────────────────

# URL produksi aplikasi (dipakai untuk redirect Midtrans)
SITE_URL=https://yourdomain.com

# ============================================================
# Artikel SEO Environment Variables
# Copy file ini ke .env.local dan isi nilai yang diperlukan.
# JANGAN pernah commit .env.local ke git.
# ============================================================

# ── AI Providers ─────────────────────────────────────────────

# SumoPod — PROVIDER UTAMA (OpenAI-compatible, 1 key untuk semua model teks + SVG).
# Dipakai untuk: Gemini 2.5 Flash (gratis), GPT-5.4, Claude Haiku 4.5, Claude Sonnet 4.6,
# serta generate SVG (gpt-4.1-mini). Ambil key di dashboard SumoPod → AI → API Keys.
SUMOPOD_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUMOPOD_BASE_URL=https://ai.sumopod.com/v1

# Google Gemini (opsional — hanya untuk generate gambar AI raster / Imagen)
# Daftar gratis di https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIzaSy-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenRouter (opsional — fallback model lain)
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI (opsional — untuk model GPT resmi)
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Supabase ─────────────────────────────────────────────────

# Project URL (dari Settings > API di Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Anon/public key (aman untuk expose di client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — RAHASIA, hanya untuk server-side!
# Memberikan akses penuh ke database (bypass RLS)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Mayar Payment ────────────────────────────────────────────

# API key Mayar (headless). Ambil di dashboard Mayar → Pengaturan → API/Webhook.
MAYAR_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Token webhook Mayar (opsional tapi disarankan — verifikasi defense-in-depth).
# Set URL webhook di Mayar ke: https://<domain>/api/payment/webhook
MAYAR_WEBHOOK_TOKEN=

# true = produksi (api.mayar.id), false = sandbox (api.mayar.club)
MAYAR_IS_PRODUCTION=false

# ── App ──────────────────────────────────────────────────────

# URL produksi aplikasi (dipakai untuk redirect pembayaran Mayar)
SITE_URL=https://seo.zaidly.com
